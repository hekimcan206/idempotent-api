{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Payments": {
    "ChargeDelayMs": 50,
    "RateLimitCapacity": 100,
    "RateLimitRefillPerSecond": 20
  },
  "AllowedHosts": "*"
}
